          <datasource-dependencies datasource='federated.0sv4c7r1cyh2d41gb7v0s0ntvfli'>
            <column caption='GDP Capita' datatype='real' name='[Calculation_5643071814213632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GDP] / [EST_POP]' />
            </column>
            <column caption='Est Pop' datatype='integer' name='[EST_POP]' role='measure' type='quantitative' />
            <column caption='GDP Capita Change (start-&gt;end)' datatype='real' default-format='p0.00%' name='[GDP Change (copy)_5920836056690692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Max Year GDP (copy)_5920836056023042] - [Min Year GDP (copy)_5920836056104963]) / [Min Year GDP (copy)_5920836056104963]' />
            </column>
            <column datatype='real' name='[GDP]' role='measure' type='quantitative' />
            <column caption='Level' datatype='integer' name='[LEVEL]' role='measure' type='quantitative' />
            <column caption='Max Year GDP Capita' datatype='real' name='[Max Year GDP (copy)_5920836056023042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF YEAR([YEAR]) = {MAX(YEAR([YEAR]))} THEN [Calculation_5643071814213632] END)' />
            </column>
            <column caption='Min Year GDP Capita' datatype='real' name='[Min Year GDP (copy)_5920836056104963]' role='measure' type='quantitative'>
