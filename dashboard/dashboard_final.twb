    <worksheet name='Growth Contribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gdp_states (2)' name='federated.0sv4c7r1cyh2d41gb7v0s0ntvfli' />
          </datasources>
          <datasource-dependencies datasource='federated.0sv4c7r1cyh2d41gb7v0s0ntvfli'>
            <column caption='GDP share (t-1)' datatype='real' name='[Calculation_0280344937586688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(SUM([GDP]) / TOTAL(SUM([GDP])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Industry Growth Rate' datatype='real' name='[Calculation_0280344937734145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GDP]) - LOOKUP(SUM([GDP]), -1)) / LOOKUP(SUM([GDP]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Growth Contribution' datatype='real' default-format='p0.00%' name='[Calculation_0280344937955330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0280344937586688] * [Calculation_0280344937734145]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='real' name='[GDP]' role='measure' type='quantitative' />
            <column caption='Level' datatype='integer' name='[LEVEL]' role='measure' type='quantitative' />
            <column caption='Naics Ldesc' datatype='string' name='[NAICS_LDESC]' role='dimension' type='nominal' />
            <column caption='State/Region' datatype='string' name='[STATE/REGION]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Year' datatype='date' name='[YEAR]' role='dimension' type='quantitative' />
            <column-instance column='[LEVEL]' derivation='None' name='[none:LEVEL:ok]' pivot='key' type='ordinal' />
            <column-instance column='[NAICS_LDESC]' derivation='None' name='[none:NAICS_LDESC:nk]' pivot='key' type='nominal' />
            <column-instance column='[YEAR]' derivation='Year-Trunc' name='[tyr:YEAR:qk]' pivot='key' type='quantitative' />
