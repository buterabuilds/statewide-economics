            <column caption='Year' datatype='date' name='[YEAR]' role='dimension' type='quantitative' />
            <column-instance column='[NAICS_LDESC]' derivation='None' name='[none:NAICS_LDESC:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0120295156637698]' derivation='Sum' name='[pcdf:sum:Calculation_0120295156637698:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
                <address>
                  <value>-1</value>
