    <worksheet name='GDP % Change YoY (w overlay)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>GDP Growth (Year over Year)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gdp_states (2)' name='federated.0sv4c7r1cyh2d41gb7v0s0ntvfli' />
          </datasources>
          <datasource-dependencies datasource='federated.0sv4c7r1cyh2d41gb7v0s0ntvfli'>
            <column caption='GDP % Change YoY' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(MAX([GDP])) - LOOKUP(ZN(MAX([GDP])), -1)) / ABS(LOOKUP(ZN(MAX([GDP])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GDP - Overall' datatype='real' name='[Calculation_0120295156637698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [YEAR],[STATE/REGION], [NAICS] : SUM(IF [NAICS] = &quot;..0&quot; THEN [GDP] END)}' />
            </column>
            <column caption='GDP - Level 0' datatype='real' name='[Calculation_0120295157612547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [YEAR], [STATE/REGION], [NAICS]: SUM(IF [LEVEL] = 0 THEN [GDP] END)}' />
            </column>
            <column datatype='real' name='[GDP]' role='measure' type='quantitative' />
            <column caption='Level' datatype='integer' name='[LEVEL]' role='measure' type='quantitative' />
            <column caption='Naics' datatype='string' name='[NAICS]' role='dimension' type='nominal' />
            <column caption='Naics Ldesc' datatype='string' name='[NAICS_LDESC]' role='dimension' type='nominal' />
