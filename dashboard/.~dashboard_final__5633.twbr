    <worksheet name='Growth Contribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gdp_states' name='federated.1bdz9mj0zyg39016kol4f0l29god' />
          </datasources>
          <datasource-dependencies datasource='federated.1bdz9mj0zyg39016kol4f0l29god'>
            <column caption='GDP share (t-1)' datatype='real' name='[Calculation_0280344937586688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(SUM([GDP]) / TOTAL(SUM([GDP])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
